// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Pagamento
  paymentId     String        @unique
  paymentStatus PaymentStatus @default(PENDING)
  billingType   String
  value         Float
  scoops        Int

  // Cliente
  nome          String
  email         String
  cpf           String
  telefone      String

  // Endereço de entrega
  rua           String
  numero        String
  complemento   String?
  bairro        String
  cidade        String
  estado        String
  cep           String
  observacoes   String?

  @@index([email])
  @@index([cpf])
  @@index([paymentStatus])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  RECEIVED_IN_CASH
  REFUND_REQUESTED
  CHARGEBACK_REQUESTED
}
